<% const asset = n => url_for('/images/novoland/' + n + '.webp');
const posters=[{n:'01',title:'特效 · 城阙'},{n:'02',title:'导演 · 棋局'},{n:'03',title:'美术 · 楼船'},{n:'04',title:'音乐 · 弦音'},{n:'05',title:'原著 · 心象'},{n:'06',title:'造型 · 铁甲'}];
%>
<article class="rb-case ep-case nv-case">
  <header class="rb-heading"><a class="case-back" href="<%- url_for(page.portfolio_home || '/visual-designer/') %>">← 返回作品集</a><div><p>NOVOLAND / CREATOR POSTERS</p><h1>九州缥缈录×主创视觉</h1><span class="rb-subtitle">柠萌影业 · 主创先行海报</span></div></header>
  <div class="rb-image ep-wide"><img src="<%- asset('creators-textless-composite') %>?v=20260914-ps" width="1920" height="1080" alt="九州缥缈录六位主创黑金视觉合辑" fetchpriority="high"></div>
  <div class="ep-intro"><div><span>PROJECT BACKGROUND / 项目背景</span><h2>黑金之下，<br>是时间留下的痕迹。</h2></div><div><p>受邀为柠萌影业剧集《九州缥缈录》设计主创人员先行海报。以黑金为主色，结合斑驳材质与明暗光影，呈现厚重、沧桑的视觉质感。</p><p>城楼、棋局、楼船与铁甲构成不同的画面主题。人物置于宏大的场景中，以统一的色调和书法文字串联整组海报。</p></div></div>
  <nav class="dewu-chapter-nav rb-index" aria-label="九州缥缈录项目章节"><a href="#nv-creators" class="active" aria-current="location"><span>01</span>主创海报</a><a href="#nv-ensemble"><span>02</span>主视觉海报</a></nav>
  <section class="rb-panel" id="nv-creators"><header><div><p>01 / CREATOR POSTER SERIES</p><h2>九州的造境者</h2><p class="rb-description">以城阙呼应特效的世界构建，以棋局映照导演的全局调度，以楼船呈现美术的空间想象；弦音对应配乐，心象呼应原著，铁甲落于造型。六位主创置身各自的创作意象，让幕后分工成为海报的叙事线索。</p></div></header><div class="nv-grid"><% posters.forEach(item=>{ %><figure><button class="ep-poster-open" type="button" aria-label="查看大图：<%= item.title %>"><img src="<%- asset('creator-'+item.n) %>" width="941" height="1672" alt="九州缥缈录主创先行海报：<%= item.title %>" loading="lazy"><span aria-hidden="true">↗</span></button><figcaption><h3><%= item.title %></h3></figcaption></figure><% }); %></div></section>
  <section class="rb-panel" id="nv-ensemble"><header><div><p>02 / KEY VISUAL POSTER</p><h2>主视觉海报</h2><p class="rb-description">吕归尘、姬野与羽然相遇于南淮，在彼此陪伴中走过少年时光，也逐渐卷入乱世纷争。海报将三人置于前景，让身后的战争与权力群像形成压迫感，呼应原著中少年情义与时代命运的纠葛。画面从左至右为宋祖儿饰羽然、刘昊然饰吕归尘（阿苏勒）、陈若轩饰姬野。</p></div></header><figure class="nv-single"><button class="ep-poster-open" type="button" data-caption="主视觉海报" aria-label="查看大图：主视觉海报"><img src="<%- asset('ensemble-poster') %>" width="935" height="1683" alt="九州缥缈录主视觉海报：左为宋祖儿饰羽然，中为刘昊然饰吕归尘，右为陈若轩饰姬野" loading="lazy"><span aria-hidden="true">↗</span></button></figure></section>
  <footer class="rb-footer"><div><span>NOVOLAND / POSTER DESIGN</span><p>九州缥缈录 · 主创视觉</p></div><a href="<%- url_for(page.portfolio_home || '/visual-designer/') %>">← 返回作品集</a></footer>
</article>
<dialog class="ep-lightbox nv-lightbox" aria-label="九州缥缈录海报大图" data-lenis-prevent><button class="ep-lightbox-close" type="button" aria-label="关闭大图">×</button><button class="ep-lightbox-prev" type="button" aria-label="上一张">‹</button><figure><img alt=""><figcaption aria-live="polite"></figcaption></figure><button class="ep-lightbox-next" type="button" aria-label="下一张">›</button></dialog>
