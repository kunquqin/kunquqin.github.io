<script>
document.addEventListener('DOMContentLoaded', function () {
  const carousel = document.getElementById('shoeCarousel');
  if (carousel) {
    let order = Array.from(carousel.querySelectorAll('.carousel-shoe'));
    let busy = false;
    const render = function () {
      order.forEach(function (shoe, index) {
        const position = index - 2;
        shoe.dataset.position = String(position);
        shoe.classList.toggle('active', position === 0);
        shoe.setAttribute('aria-pressed', position === 0 ? 'true' : 'false');
      });
    };
    const wait = function (ms) { return new Promise(function (resolve) { window.setTimeout(resolve, ms); }); };
    const shiftTo = async function (distance) {
      const wrapCount = Math.abs(distance);
      const wrapping = distance > 0 ? order.slice(0, wrapCount) : order.slice(order.length - wrapCount);
      const ghosts = wrapping.map(function (shoe, index) {
        const ghost = shoe.cloneNode(true);
        const destination = distance > 0 ? 3 - wrapCount + index : -2 + index;
        ghost.classList.remove('active'); ghost.classList.add('carousel-ghost', 'instant', 'edge-reset');
        ghost.dataset.position = String(distance > 0 ? 3 + index : -3 - index);
        ghost.dataset.destination = String(destination); ghost.removeAttribute('aria-pressed'); ghost.setAttribute('aria-hidden','true'); ghost.tabIndex = -1;
        carousel.appendChild(ghost); return ghost;
      });
      ghosts.forEach(function (ghost) { void ghost.offsetWidth; ghost.classList.remove('instant'); });
      requestAnimationFrame(function () { ghosts.forEach(function (ghost) { ghost.dataset.position = ghost.dataset.destination; ghost.classList.remove('edge-reset'); }); });
      order.forEach(function (shoe, index) {
        const destination = index - 2 - distance;
        shoe.dataset.position = String(destination);
        shoe.classList.toggle('active', destination === 0);
        shoe.setAttribute('aria-pressed', destination === 0 ? 'true' : 'false');
      });
      await wait(520);
      let entering;
      if (distance > 0) {
        entering = order.splice(0, distance);
        order = order.concat(entering);
      } else {
        entering = order.splice(order.length + distance, -distance);
        order = entering.concat(order);
      }
      entering.forEach(function (shoe) { shoe.classList.add('instant'); });
      render();
      entering.forEach(function (shoe) { void shoe.offsetWidth; shoe.classList.remove('instant'); });
      ghosts.forEach(function (ghost) { ghost.remove(); });
      await wait(40);
    };
    const select = async function (shoe) {
      if (busy) return;
      let distance = order.indexOf(shoe) - 2;
      if (!distance) return;
      busy = true;
      await shiftTo(distance);
      busy = false;
    };
    order.forEach(function (shoe) { shoe.addEventListener('click', function () { select(shoe); }); });
    if (window.matchMedia('(pointer:fine)').matches) {
      carousel.addEventListener('pointermove', function (event) {
        const current = order[2]; const r = current.getBoundingClientRect();
        const x = Math.max(-.5, Math.min(.5, (event.clientX-r.left)/r.width-.5));
        const y = Math.max(-.5, Math.min(.5, (event.clientY-r.top)/r.height-.5));
        current.style.setProperty('--gyro-x', (y*-14)+'deg'); current.style.setProperty('--gyro-y', (x*18)+'deg');
      });
      carousel.addEventListener('pointerleave', function () { order[2].style.setProperty('--gyro-x','0deg'); order[2].style.setProperty('--gyro-y','0deg'); });
    }
    render();
  }
  document.querySelectorAll('[data-pipeline]').forEach(function(btn){ btn.addEventListener('click',function(){ document.querySelectorAll('[data-pipeline]').forEach(b=>b.classList.remove('active')); document.querySelectorAll('[data-mode]').forEach(m=>m.classList.remove('active')); btn.classList.add('active'); document.querySelector('[data-mode="'+btn.dataset.pipeline+'"]').classList.add('active'); }); });
  document.querySelectorAll('.result-visuals figure').forEach(function (card) {
    card.addEventListener('pointermove', function (event) {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', ((event.clientX - rect.left) / rect.width * 100).toFixed(1) + '%');
      card.style.setProperty('--my', ((event.clientY - rect.top) / rect.height * 100).toFixed(1) + '%');
    });
  });
  if (window.matchMedia('(pointer:fine)').matches) {
    document.querySelectorAll('.quality-phone').forEach(function (card) {
      card.addEventListener('pointermove', function (event) {
        const rect = card.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        card.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
        card.style.setProperty('--my', (y * 100).toFixed(1) + '%');
        card.style.setProperty('--tilt-x', ((.5 - y) * 5).toFixed(2) + 'deg');
        card.style.setProperty('--tilt-y', ((x - .5) * 7).toFixed(2) + 'deg');
        card.style.setProperty('--tip-x', Math.max(66, Math.min(rect.width - 66, event.clientX - rect.left + 18)) + 'px');
        card.style.setProperty('--tip-y', Math.max(38, Math.min(rect.height - 38, event.clientY - rect.top - 22)) + 'px');
      });
      card.addEventListener('pointerleave', function () {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
      });
    });
  }
  const browse = document.getElementById('dewuBrowse');
  if (browse) {
    const stage = browse.querySelector('.browse-sticky');
    const layer = browse.querySelector('.reaction-layer');
    let browseProgress = 0;
    let browseTicking = false;
    const clamp01 = function (value) { return Math.max(0, Math.min(1, value)); };
    const updateBrowse = function () {
      const rect = browse.getBoundingClientRect();
      const stickyHeight = stage.getBoundingClientRect().height;
      const travel = Math.max(1, browse.offsetHeight - stickyHeight);
      const layered = window.matchMedia('(min-width:901px)').matches;
      const coverDistance = layered ? stickyHeight : 0;
      const narrativeTravel = Math.max(1, travel - coverDistance * 2);
      browseProgress = clamp01((72 - rect.top - coverDistance) / narrativeTravel);
      const shoeExit = clamp01((browseProgress - .34) / .22);
      const shoeIntro = clamp01((browseProgress - .025) / .10);
      const shoeOutro = 1 - clamp01((browseProgress - .24) / .10);
      const figureIntro = clamp01((browseProgress - .56) / .12);
      const figureOutro = 1 - clamp01((browseProgress - .88) / .09);
      browse.style.setProperty('--shoe-exit', shoeExit.toFixed(4));
      browse.style.setProperty('--shoe-copy-opacity', (shoeIntro * shoeOutro).toFixed(4));
      browse.style.setProperty('--shoe-copy-y', ((1 - shoeIntro) * 28 - (1 - shoeOutro) * 18) + 'px');
      browse.style.setProperty('--figure-copy-opacity', (figureIntro * figureOutro).toFixed(4));
      browse.style.setProperty('--figure-copy-y', ((1 - figureIntro) * 28 - (1 - figureOutro) * 18) + 'px');
      browse.classList.toggle('phase-shoes', browseProgress < .5);
      browse.classList.toggle('phase-figures', browseProgress >= .5);
      browse.classList.toggle('is-visible', browseProgress > .02 && browseProgress < .98);
      browseTicking = false;
    };
    const requestBrowseUpdate = function () { if (!browseTicking) { browseTicking = true; requestAnimationFrame(updateBrowse); } };
    window.addEventListener('scroll', requestBrowseUpdate, { passive:true });
    window.addEventListener('resize', requestBrowseUpdate);
    if (window.matchMedia('(pointer:fine)').matches && !window.matchMedia('(prefers-reduced-motion:reduce)').matches) {
      let lastReaction = 0;
      stage.addEventListener('pointermove', function (event) {
        const now = performance.now();
        if (now - lastReaction < 200) return;
        lastReaction = now;
        const scene = browse.querySelector(browseProgress < .5 ? '.scene-shoes' : '.scene-figures');
        const rect = stage.getBoundingClientRect();
        const particle = document.createElement('img');
        particle.className = 'reaction-particle';
        particle.src = scene.dataset.reaction;
        particle.alt = '';
        particle.style.left = (event.clientX - rect.left) + 'px';
        particle.style.top = (event.clientY - rect.top) + 'px';
        particle.style.setProperty('--size', (32 + Math.random() * 20) + 'px');
        const life = 980 + Math.random() * 300;
        const wave = 12 + Math.random() * 13;
        const phase = Math.random() * Math.PI * 2;
        const drift = (Math.random() - .5) * 24;
        const rotation = (Math.random() - .5) * 18;
        layer.appendChild(particle);
        const frames = [];
        for (let i = 0; i <= 36; i += 1) {
          const t = i / 36;
          const x = Math.sin(t * Math.PI * 2.15 + phase) * wave * (1 - t * .3) + drift * t;
          const y = -178 * t;
          const opacity = t < .12 ? t / .12 * .82 : (t > .78 ? (1 - t) / .22 * .82 : .82);
          frames.push({ transform: 'translate(calc(-50% + ' + x.toFixed(2) + 'px), calc(-50% + ' + y.toFixed(2) + 'px)) scale(' + (1 - t * .66).toFixed(3) + ') rotate(' + (rotation * t + Math.sin(t * Math.PI * 2 + phase) * 3).toFixed(2) + 'deg)', opacity: Math.max(0, opacity).toFixed(3) });
        }
        const motion = particle.animate(frames, { duration: life, easing: 'linear', fill: 'forwards' });
        motion.finished.then(function () { particle.remove(); }).catch(function () { particle.remove(); });
      });
    }
    updateBrowse();
  }
});
</script>
