<% const asset = n => url_for('/images/epo/' + n + '.webp');
const chapters = [
 {id:'epo-character',number:'01',en:'CHARACTER DESIGN',label:'形象设计',title:'给商户服务，一个亲切的面孔。',copy:'从草图到角色设定，用圆角轮廓、屏幕表情与蓝色细节塑造 E宝。机器人形象传递服务属性，简洁的五官和姿态则为产品沟通增加情绪表达。',images:[{n:'02',en:'SKETCHES & CHARACTER',title:'从草图探索到角色设定',alt:'E宝角色草图、正背面造型与蓝白配色设计稿'}]},
 {id:'epo-product',number:'02',en:'PRODUCT APPLICATION',label:'产品应用',title:'让工具化的页面，多一点陪伴感。',copy:'将 E宝融入商户端页面，让角色与运营内容、服务信息共同出现。统一的形象和品牌蓝，让不同页面保有连续的视觉识别。',images:[{n:'03',en:'E-PO IN PRODUCT',title:'商户端页面效果',alt:'E宝在饿了么商户端多种手机页面中的应用展示'}]},
 {id:'epo-extension',number:'03',en:'BRAND VISUAL EXTENSION / DEMO',label:'视觉延展',title:'从屏幕里的助手，到完整的品牌形象。',copy:'以设计图纸、角色模型、材质样本和包装陈列展开视觉概念。灰白基调突出造型与结构，少量品牌蓝建立记忆点，形成具有工业设计气质的展示系统。',images:[{n:'04',en:'DESIGN LANGUAGE',title:'以图纸梳理角色的造型语言',alt:'E宝角色线稿、表情与结构细节的图纸展示'},{n:'05',en:'CHARACTER MODEL / DEMO',title:'从平面图纸到三维角色',alt:'透明展示盒、E宝模型和绘图工具组成的概念场景'},{n:'06',en:'MATERIAL STUDY / DEMO',title:'灰白材质中的一抹品牌蓝',alt:'蓝色金属球与灰白黑材质球、品牌底座的三维展示'},{n:'07',en:'VISUAL SYSTEM / DEMO',title:'让角色、包装与物料形成整体',alt:'E宝角色模型、包装、图纸与材质样本的完整视觉概念陈列'}]}
]; %>
<article class="rb-case ep-case epo-case">
  <header class="rb-heading"><a class="case-back" href="<%- url_for(page.portfolio_home || '/visual-designer/') %>">← 返回作品集</a><div><p>ELE.ME / E-PO CHARACTER DESIGN</p><h1>E宝设计</h1><span class="rb-subtitle">饿了么商户端 IP · 角色设计 · 产品应用 · 品牌视觉延展</span></div></header>
  <div class="rb-image ep-wide"><img src="<%- asset('01') %>" width="1920" height="1080" alt="E宝服务机器人与 E-PO 品牌包装的灰白工业风格展示" fetchpriority="high"></div>
  <div class="ep-intro"><div><span>PROJECT BACKGROUND / 项目背景</span><h2>让商户服务，<br>拥有可以记住的形象。</h2></div><div><p>饿了么商户端产品偏工具化、轻视觉，与品牌之间缺少情感联系。E宝以商户端情感化 IP 为出发点，希望通过亲切的角色形象提升品牌亲和力。</p><p>将角色融入产品、服务商户，建立商家与品牌的情感联系。项目从角色设计延伸至页面应用，并探索品牌视觉与三维展示的更多可能。</p><div class="ep-tags"><span>商户服务</span><span>情感化 IP</span><span>品牌亲和力</span></div></div></div>
  <nav class="dewu-chapter-nav rb-index" aria-label="E宝项目章节"><% chapters.forEach((chapter,i)=>{ %><a href="#<%= chapter.id %>"<% if(i===0){ %> class="active" aria-current="location"<% } %>><span><%= chapter.number %></span><%= chapter.label %></a><% }); %></nav>
  <% chapters.forEach(chapter=>{ %><section class="rb-panel" id="<%= chapter.id %>"><header><div><p><%= chapter.number %> / <%= chapter.en %></p><h2><%= chapter.title %></h2><p class="rb-description"><%= chapter.copy %></p></div></header><div class="ep-stack"><% chapter.images.forEach(item=>{ %><figure><button class="ep-poster-open" type="button" aria-label="查看大图：<%= item.title %>"><img src="<%- asset(item.n) %>" width="<%= item.n==='07'?2560:1920 %>" height="<%= item.n==='07'?1440:1080 %>" alt="<%= item.alt %>" loading="lazy"><span aria-hidden="true">↗</span></button><figcaption><span><%= item.en %></span><h3><%= item.title %></h3></figcaption></figure><% }); %></div></section><% }); %>
  <footer class="rb-footer"><div><span>E-PO / MERCHANT SERVICE CHARACTER</span><p>以角色建立识别，以场景延续品牌表达。</p></div><a href="<%- url_for(page.portfolio_home || '/visual-designer/') %>">← 返回作品集</a></footer>
<%- partial('partial/project-next', {nextClass: 'case-next portfolio-case-next'}) %>
</article>
<dialog class="ep-lightbox" aria-label="E宝设计作品大图" data-lenis-prevent><button class="ep-lightbox-close" type="button" aria-label="关闭大图">×</button><button class="ep-lightbox-prev" type="button" aria-label="上一张">‹</button><figure><img alt=""><figcaption aria-live="polite"></figcaption></figure><button class="ep-lightbox-next" type="button" aria-label="下一张">›</button></dialog>
<script src="<%- url_for('js/eleme-pacman.js') %>" defer></script>
