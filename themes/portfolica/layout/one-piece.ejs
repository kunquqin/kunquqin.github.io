<% const works = site.data.one_piece; const base = '/3d-character/projects/one-piece/'; const current = works.find(w => w.slug === page.character_slug); const asset = (w, name) => url_for('/images/one-piece/' + w.slug + '/' + name); %>
<article class="op-case">
  <nav class="op-breadcrumb" aria-label="面包屑"><a href="<%- url_for('/3d-character/') %>">← 3D角色设计</a><% if(current){ %><span>/</span><a href="<%- url_for(base) %>">海贼王3D角色创作</a><span>/</span><span><%= current.name %></span><% } %></nav>
  <header class="op-heading<%= current ? '' : ' op-heading-logo' %>"><% if(current){ %><p class="op-eyebrow">ONE PIECE / <%= current.english %></p><h1><%= current.name %></h1><% } else { %><h1><img class="op-logo" src="<%- url_for('/images/one-piece/logo.webp') %>" alt="海贼王3D角色创作 · ONE PIECE" fetchpriority="high"></h1><% } %></header>
  <% if(!current){ %>
  <div class="op-collection featured-projects"><% works.forEach((w,i)=>{ %><a class="op-card featured-card" href="<%- url_for(base + w.slug + '/') %>"><img src="<%- asset(w,'cover.webp') %>" alt="<%= w.name %>三维角色作品" width="800" height="600" <%- i ? 'loading="lazy"' : 'fetchpriority="high"' %>><div class="card-overlay"><span class="op-card-en"><%= w.english %></span><h3 aria-label="<%= w.name %>"><% Array.from(w.name).forEach(letter=>{ %><i aria-hidden="true"><%= letter %></i><% }); %></h3></div></a><% }); %></div>
  <% } else { %>
  <section class="op-project-info" aria-label="作品介绍"><div class="op-original-copy"><% current.paragraphs.filter(text=>!text.includes('工具：')).forEach(text=>{ %><p><%= text %></p><% }); %></div><aside class="op-tools" aria-label="制作工具"><span class="op-tools-label">制作工具</span><ul><% current.tools.forEach(tool=>{ %><li><%= tool %></li><% }); %></ul></aside></section>
  <section class="op-gallery" aria-label="<%= current.name %>作品图集"><% current.images.forEach((im,i)=>{ %><figure><% if(current.slug === 'rayleigh' && im.file === '06.webp'){ %><p class="op-original-caption">弄张壁纸(#^.^#)</p><% } %><button class="ep-poster-open" type="button" aria-label="查看<%= current.name %>作品大图 <%= i+1 %>" data-caption="<%= current.name %>"><img src="<%- asset(current,im.file) %>" width="<%= im.width %>" height="<%= im.height %>" alt="<%= current.name %>角色创作 · 作品 <%= i+1 %>" loading="lazy"></button></figure><% }); %></section>
  <% const next = works[(works.indexOf(current)+1)%works.length]; %><nav class="op-footer" aria-label="角色作品导航"><a href="<%- url_for(base) %>">← 返回角色合集</a><a href="<%- url_for(base+next.slug+'/') %>"><small>下一个作品</small><strong><%= next.name %> →</strong></a></nav>
  <% } %>
</article>
<% if(current){ %><dialog class="ep-lightbox" aria-label="角色作品大图" data-lenis-prevent><button class="ep-lightbox-close" type="button" aria-label="关闭大图">×</button><button class="ep-lightbox-prev" type="button" aria-label="上一张">‹</button><figure><img alt=""><figcaption aria-live="polite"></figcaption></figure><button class="ep-lightbox-next" type="button" aria-label="下一张">›</button></dialog><script src="<%- url_for('js/eleme-pacman.js') %>" defer></script><% } %>
