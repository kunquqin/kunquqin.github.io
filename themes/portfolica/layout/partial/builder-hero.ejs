<% const isCharacter = page.portfolio_mode === 'character'; const isBrand = page.portfolio_mode === 'brand'; const isVisual = ['visual', '3d'].includes(page.portfolio_mode) || isBrand; const slides = [
  {name:'嘟记豆', title:'学习，从一点好奇开始。', lead:'从单词学习体验、角色设计到 AI 协作开发，把一个小想法做成可以使用的背单词产品。', image:'/images/mimo/ai_product_dujidou_cover.png', slug:'mimo', cardTitle:'嘟记豆背单词'},
  {name:'喵息', title:'谁说闹钟不懂你？', lead:'给忙碌的日常留一点休息时间。独立完成桌面闹钟的产品设计、AI 协作开发与上线，让提醒更贴合工作节奏。', image:'/images/meowbreak/ai_product_MeowBreak_cover.png', slug:'meowbreak', cardTitle:'喵息桌面闹钟'},
  {name:'幻星', title:'有个性的数字人', lead:'从角色形象到内容体验，参与虚拟数字人产品与视觉体系建设，让想象中的人物有自己的样子。', image:'/images/portfolio-hd/zstar-group.png', slug:'zstar', cardTitle:'哔哩哔哩 · 幻星项目'},
]; if(page.portfolio_mode === 'ai-product') slides.push({name:'得物',title:'让购物更沉浸',lead:'从鞋类商品的 3D/AR 展示体验出发，建立数字资产标准与自动化生产流程，推动规模化制作与上线交付。',image:'/images/portfolio-hd/dewu_3d_cover.png',slug:'dewu',cardTitle:'得物 3D 数字资产升级'}); if(isVisual) slides.forEach(function(slide, i){ Object.assign(slide, (page.portfolio_mode === '3d' ? site.data.three_d : site.data.visual_designer).slides[i]); }); if(page.portfolio_mode === 'visual') {
  Object.assign(slides[0], {name:'雷朋',title:'雷朋×天猫双十一主视觉',lead:'将雷朋眼镜与写实猫头结合，以三维视觉呈现品牌联名创意，延展至线上店铺与线下广告。',image:'/images/rayban-tmall/cover.webp',slug:'rayban-tmall',cardTitle:'雷朋×天猫双十一主视觉'});
  Object.assign(slides[1], {name:'巨量引擎',title:'点燃每个营销时刻',lead:'从千川55大促到企业号双节活动，以鲜明的场景承载品牌，将营销创意延展为移动端活动体验。',image:'/images/ocean-engine/cover.webp',slug:'ocean-engine',cardTitle:'巨量引擎活动视觉设计'});
  slides.splice(2, 0, {name:'吃货豆',title:'让品牌多一点趣味',lead:'围绕饿了么吃货卡，探索角色形象、三维表现与活动应用，让 IP 走进用户熟悉的消费场景。',image:'/images/eleme-pacman/beans.webp',slug:'eleme-pacman',cardTitle:'IP设计 · 吃货豆'});
} if(isBrand) slides.unshift({name:'Meshy',title:'想象，有了形状。',lead:'以 Meshy 为对象的自主品牌传播提案。从产品价值、创意方向到视觉体系，让想法走出平面，成为可感知的形状。',image:'/images/meshy/ideas-take-shape.webp',slug:'meshy',cardTitle:'Meshy · 品牌创意提案'}); %>
<% if(isCharacter) slides.splice(0, slides.length, ...site.data.character_designer.slides); %>
<section class="builder-hero" id="home" aria-label="精选作品" <%- slides.length > 1 ? 'aria-roledescription="轮播"' : '' %>>
  <% slides.forEach(function(slide, i){ %><div class="builder-glow builder-glow-<%= slide.slug %><%= i === 0 ? ' is-active' : '' %>" aria-hidden="true"></div><% }); %>
  <div class="builder-copy">
    <%- partial('partial/role-switcher') %>
    <div class="builder-identity<%= (page.portfolio_mode === 'ai-product' || isCharacter) ? ' builder-identity-product' : '' %>"><strong>覃保锟</strong><span><%= isCharacter ? '3D角色设计' : page.portfolio_mode === '3d' ? '3D 设计' : isBrand ? '品牌与创意设计师 · 3D / AI' : isVisual ? '视觉设计师 · 3D / AIGC' : '产品设计' %></span></div>
    <div class="builder-stories">
      <% slides.forEach(function(slide, i){ %>
      <div class="builder-story<%= i === 0 ? ' is-active' : '' %>" <%- i ? 'inert aria-hidden="true"' : '' %>>
        <span class="builder-project-tag"><%= slide.cardTitle %></span>
        <<%= i === 0 ? 'h1' : 'h2' %>><% if(i === 0 && isBrand){ %>想象，<br>有了形状。<% } else if(i === 0 && !isVisual && !isCharacter){ %>学习，<br>从一点好奇开始。<% } else { %><%= slide.title %><% } %></<%= i === 0 ? 'h1' : 'h2' %>>
        <p class="builder-lead"><%= slide.lead %></p>
        <div class="hero-actions"><a class="button button-primary" href="<%- url_for('/projects/' + slide.slug + '/') %>">查看项目 <i>↗</i></a><a class="button button-ghost" href="#projects"><%= isCharacter ? '浏览作品' : '更多作品' %></a></div>
      </div>
      <% }); %>
    </div>
  </div>
  <div class="builder-showcase">
    <div class="builder-deck">
      <% slides.forEach(function(slide, i){ %>
      <a class="featured-card builder-card<%= i === 0 ? ' is-active' : '' %>" href="<%- url_for('/projects/' + slide.slug + '/') %>" aria-label="查看<%= slide.name %>项目" <%- i ? 'inert aria-hidden="true"' : '' %>>
        <img src="<%- url_for(slide.image) %>" alt="<%= slide.name %>项目作品" <%- i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>>
      </a>
      <% }); %>
    </div>
    <% if(slides.length > 1){ %><div class="builder-arrows"><button type="button" data-step="-1" aria-label="上一个项目"></button><button type="button" data-step="1" aria-label="下一个项目"></button></div>
    <nav class="builder-dots ip17-results-dots" aria-label="选择展示项目"><% slides.forEach(function(slide, i){ %><button type="button" data-slide="<%= i %>" aria-label="展示<%= slide.name %>" aria-current="<%= i === 0 %>"></button><% }); %></nav><% } %>
  </div>
  <span class="builder-status" role="status" aria-live="polite"></span>
</section>
