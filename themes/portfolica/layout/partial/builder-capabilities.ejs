<section class="portfolio-section builder-capabilities" id="capabilities" aria-labelledby="builder-capabilities-title">
  <div class="section-label">02 / 核心能力</div>
  <div class="builder-capabilities-layout">
    <div>
      <h2 id="builder-capabilities-title">核心能力</h2>
      <ul class="builder-capability-list">
        <% ['AI 产品原型设计', 'Cursor / Claude Demo 开发', 'C 端体验设计', 'AIGC 内容工作流', '0–1 产品验证', '项目闭环推进'].forEach(function(item, i){ %>
