<section id="contact" class="contact">
    <div class="contact-container">
        <p class="section-eyebrow reveal">Contact</p>
        <h2 class="section-title section-title--contact reveal">Have a project<br>in mind?</h2>
        <form class="contact-form reveal" id="contact-form" action="#" method="post">
            <label class="sr-only" for="contact-name">Name</label>
            <input type="text" id="contact-name" name="name" class="form-input" placeholder="Name" required autocomplete="name">
            <label class="sr-only" for="contact-email">Email</label>
            <input type="email" id="contact-email" name="email" class="form-input" placeholder="Email" required autocomplete="email">
            <label class="sr-only" for="contact-message">Project Information</label>
            <textarea id="contact-message" name="message" class="form-input form-textarea" placeholder="Project Information" required></textarea>
            <button type="submit" class="btn-primary btn-large"><%= theme.contact.button_text %></button>
        </form>
        <p class="contact-note reveal"><%= theme.contact.note %></p>
        <p class="contact-email reveal">Or email me at <a href="mailto:<%= theme.contact.email %>"><%= theme.contact.email %></a></p>
    </div>
</section>
