</article>
<script>
document.addEventListener('DOMContentLoaded',function(){const screens=document.querySelectorAll('[data-demo-screen]');document.querySelectorAll('[data-demo-target]').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('[data-demo-target]').forEach(b=>b.classList.remove('active'));screens.forEach(s=>s.classList.remove('active'));button.classList.add('active');const target=document.querySelector('[data-demo-screen="'+button.dataset.demoTarget+'"]');if(target)target.classList.add('active')})});const flowData={learn:{label:'LEARN / 学习系统',title:'用户专注完成今天，系统负责安排顺序。',summary:'新词、到期复习与阶段考核被组织在同一个学习入口中，用户不需要理解复杂规则。',surface:'一个清晰的今日任务与连续卡片',system:'考核 ＞ 复习 ＞ 新词的队列优先级',tags:['卡片学习','四类考核','断点续学']},library:{label:'LIBRARY / 我的词库',title:'查找、整理和定位，都围绕当前词库发生。',summary:'搜索、筛选、收藏和书签共享同一套词库上下文，避免切换功能后丢失位置与条件。',surface:'统一的列表、筛选与书签入口',system:'分页查询、位置索引与状态复用',tags:['实时搜索','组合筛选','书签定位']},growth:{label:'GROWTH / 成长反馈',title:'让每次完成都被记录，也能被感知。',summary:'首页进度、签到和学习统计使用一致的数据来源，把短期任务连接为长期成长。',surface:'连续天数、今日进度与趋势变化',system:'每日记录、统计聚合与云端同步',tags:['学习进度','连续签到','趋势统计']},profile:{label:'PROFILE / 账户服务',title:'把服务能力收在主任务之外，需要时再出现。',summary:'会员、设置、消息与反馈集中在账户区域，不干扰每日学习路径，同时支撑产品运营。',surface:'清晰的账户状态与服务入口',system:'权限校验、订单消息与反馈闭环',tags:['会员权限','主题设置','意见反馈']}};const flowPanel=document.querySelector('[data-flow-panel]');document.querySelectorAll('[data-flow-target]').forEach(function(button){button.addEventListener('click',function(){const key=button.dataset.flowTarget,data=flowData[key];if(!flowPanel||!data)return;document.querySelectorAll('[data-flow-target]').forEach(b=>b.classList.remove('active'));button.classList.add('active');flowPanel.classList.add('changing');setTimeout(function(){flowPanel.dataset.flowPanel=key;flowPanel.querySelector('[data-flow-label]').textContent=data.label;flowPanel.querySelector('[data-flow-title]').textContent=data.title;flowPanel.querySelector('[data-flow-summary]').textContent=data.summary;flowPanel.querySelector('[data-flow-surface]').textContent=data.surface;flowPanel.querySelector('[data-flow-system]').textContent=data.system;flowPanel.querySelector('[data-flow-tags]').innerHTML=data.tags.map(t=>'<span>'+t+'</span>').join('');flowPanel.classList.remove('changing')},130)})});document.querySelectorAll('[data-ai-target]').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('[data-ai-target]').forEach(b=>b.classList.remove('active'));document.querySelectorAll('[data-ai-panel]').forEach(p=>p.classList.remove('active'));button.classList.add('active');const panel=document.querySelector('[data-ai-panel="'+button.dataset.aiTarget+'"]');if(panel)panel.classList.add('active')})});const modal=document.querySelector('.mimo2-experience-modal');function toggleModal(open){if(!modal)return;modal.classList.toggle('open',open);modal.setAttribute('aria-hidden',String(!open));document.body.style.overflow=open?'hidden':''}document.querySelectorAll('[data-open-experience]').forEach(b=>b.addEventListener('click',()=>toggleModal(true)));document.querySelectorAll('[data-close-experience]').forEach(b=>b.addEventListener('click',()=>toggleModal(false)));document.addEventListener('keydown',e=>{if(e.key==='Escape')toggleModal(false)});const navLinks=document.querySelectorAll('.mimo2-chapter-nav a');navLinks.forEach(function(link){link.addEventListener('click',function(event){const target=document.querySelector(link.getAttribute('href'));if(!target)return;event.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'});history.replaceState(null,'',link.getAttribute('href'))})});const observed=Array.from(navLinks).map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){navLinks.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+entry.target.id))}}),{rootMargin:'-30% 0px -60%',threshold:0});observed.forEach(section=>observer.observe(section))}});
</script>
<script>
document.addEventListener('DOMContentLoaded',function(){function alignBrandDevice(){const brand=document.querySelector('.mimo2-story-legacy .mimo2-brand'),board=brand&&brand.querySelector('.brand-color-board'),phone=brand&&brand.querySelector('.brand-real-phone');if(!brand||!board||!phone||window.innerWidth<=820){if(phone){phone.style.top='';phone.style.transform=''}return}const brandTop=brand.getBoundingClientRect().top,boardBottom=board.getBoundingClientRect().bottom-brandTop;phone.style.top=Math.max(24,boardBottom-phone.offsetHeight)+'px';phone.style.bottom='auto';phone.style.transform='translateX(-50%)'}requestAnimationFrame(alignBrandDevice);window.addEventListener('load',alignBrandDevice);window.addEventListener('resize',alignBrandDevice)});
