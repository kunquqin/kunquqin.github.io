<script>
document.addEventListener('DOMContentLoaded',function(){const story=document.querySelector('.mimo2-design-story');if(!story)return;const panels=story.querySelectorAll('[data-story-panel]'),screens=story.querySelectorAll('[data-story-screen]');let experienceScreen='home',theme='light',progress=0;const clamp=value=>Math.max(0,Math.min(1,value)),mix=(a,b,p)=>Math.round(a+(b-a)*p);function paint(){story.style.setProperty('--story-p',progress.toFixed(3));story.style.backgroundColor='rgb('+mix(16,242,progress)+','+mix(29,239,progress)+','+mix(20,230,progress)+')';story.style.color=progress>.52?'#152019':'#ffffff';panels.forEach(panel=>panel.style.pointerEvents=(panel.dataset.storyPanel===(progress>.5?'brand':'experience'))?'auto':'none');screens.forEach(screen=>{const isExperience=screen.dataset.storyScreen===experienceScreen,isTheme=screen.dataset.storyScreen===theme,visible=isExperience||isTheme;screen.classList.toggle('active',visible);screen.style.opacity=isExperience?String(1-progress):isTheme?String(progress):'0';screen.style.pointerEvents='none'})}story.querySelectorAll('[data-story-demo]').forEach(button=>button.addEventListener('click',function(){experienceScreen=button.dataset.storyDemo;story.querySelectorAll('[data-story-demo]').forEach(item=>item.classList.toggle('active',item===button));paint()}));story.querySelectorAll('[data-story-theme]').forEach(button=>button.addEventListener('click',function(){theme=button.dataset.storyTheme;story.querySelectorAll('[data-story-theme]').forEach(item=>item.classList.toggle('active',item===button));paint()}));function updateStory(){if(window.innerWidth<=680)return;const rect=story.getBoundingClientRect(),start=window.innerHeight*.42,distance=window.innerHeight*.62;progress=clamp((-rect.top-start)/distance);paint()}window.addEventListener('scroll',updateStory,{passive:true});window.addEventListener('resize',updateStory);updateStory()});
</script>
