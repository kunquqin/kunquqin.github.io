<article class="simple-page">
    <header class="simple-page__hero">
        <p class="section-eyebrow"><%= page.subtitle || 'Page' %></p>
        <h1 class="simple-page__title"><%= page.title %></h1>
    </header>
    <div class="simple-page__body section-container">
        <div class="simple-page__content">
            <%- page.content %>
        </div>
    </div>
</article>
