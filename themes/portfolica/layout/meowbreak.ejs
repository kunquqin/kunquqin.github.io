<script>
document.addEventListener('DOMContentLoaded',function(){const homeCompare=document.querySelector('[data-mb-home-compare]');if(homeCompare){let resetTimer;homeCompare.addEventListener('pointerenter',()=>{clearTimeout(resetTimer);homeCompare.classList.add('is-hovering')});homeCompare.addEventListener('pointermove',function(event){const rect=homeCompare.getBoundingClientRect(),x=Math.max(0,Math.min(rect.width,event.clientX-rect.left));homeCompare.style.setProperty('--mb-wipe-x',x+'px')});homeCompare.addEventListener('pointerleave',()=>{homeCompare.classList.remove('is-hovering');resetTimer=setTimeout(()=>homeCompare.style.removeProperty('--mb-wipe-x'),360)})}const buttons=document.querySelectorAll('[data-mb-tab]');buttons.forEach(function(button){button.addEventListener('click',function(){buttons.forEach(b=>b.classList.toggle('active',b===button));document.querySelectorAll('[data-mb-panel]').forEach(p=>p.classList.toggle('active',p.dataset.mbPanel===button.dataset.mbTab));document.querySelectorAll('[data-mb-visual]').forEach(p=>p.classList.toggle('active',p.dataset.mbVisual===button.dataset.mbTab))})});const posterModal=document.querySelector('.mb-poster-modal'),posterImage=posterModal&&posterModal.querySelector('img');function togglePoster(open,src){if(!posterModal||!posterImage)return;if(src)posterImage.src=src;posterModal.classList.toggle('open',open);posterModal.setAttribute('aria-hidden',String(!open));document.body.style.overflow=open?'hidden':''}document.querySelectorAll('[data-mb-poster]').forEach(button=>button.addEventListener('click',()=>togglePoster(true,button.dataset.mbPoster)));document.querySelectorAll('[data-mb-poster-close]').forEach(button=>button.addEventListener('click',()=>togglePoster(false)));document.addEventListener('keydown',e=>{if(e.key==='Escape')togglePoster(false)});const links=document.querySelectorAll('.mb-chapter-nav a');links.forEach(link=>link.addEventListener('click',function(e){const target=document.querySelector(link.getAttribute('href'));if(target){e.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'});history.replaceState(null,'',link.getAttribute('href'))}}));if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+entry.target.id))}),{rootMargin:'-30% 0px -60%'});links.forEach(a=>{const s=document.querySelector(a.getAttribute('href'));if(s)observer.observe(s)})}});
</script>
